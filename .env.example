# External Vehicle API (CheckCarDetails live key)
VEHICLE_API_KEY=

# DVLA Vehicle Enquiry Service (Tax Status / Tax Due / MOT Status / MOT Expiry)
DVLA_API_KEY=

# Admin Dashboard Password
ADMIN_PASSWORD=

# Neon Postgres connection string
DATABASE_URL=

# How long cached VRM lookups remain valid
CACHE_DURATION_DAYS=7

# Buy Credits redirect (Shopify collection URL when ready)
BUY_CREDITS_URL=https://www.keylibrary.co.uk/

# Cookie session signing secret (use a long random string in production)
SESSION_SECRET=

# Local server port
PORT=3000

# £ of order subtotal required for 1 lookup credit (default: £25 = 1 credit)
CREDITS_POUNDS_PER_CREDIT=25

# Only count Shopify orders on/after this date (YYYY-MM-DD)
CREDITS_START_DATE=2026-07-22

# Local-only launch script (do not commit real values)
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
